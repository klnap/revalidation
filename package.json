{
  "name": "@klnap/revalidation",
  "version": "0.5.1",
  "description": "Declarative, type-safe cache invalidation across applications with a framework-independent event protocol and native Payload CMS, HTTP, and Next.js integrations.",
  "keywords": [
    "revalidation",
    "cache",
    "cache-invalidation",
    "cache-tags",
    "type-safe",
    "event-driven",
    "nextjs",
    "payloadcms"
  ],
  "homepage": "https://github.com/klnap/revalidation#readme",
  "bugs": {
    "url": "https://github.com/klnap/revalidation/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klnap/revalidation.git"
  },
  "license": "MIT",
  "author": "klnap",
  "packageManager": "bun@1.4.5",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./producers/payload": {
      "types": "./dist/producers/payload/index.d.ts",
      "default": "./dist/producers/payload/index.js"
    },
    "./consumers/next": {
      "types": "./dist/consumers/next/index.d.ts",
      "default": "./dist/consumers/next/index.js"
    },
    "./dispatchers": {
      "types": "./dist/dispatchers/index.d.ts",
      "default": "./dist/dispatchers/index.js"
    },
    "./dispatchers/http": {
      "types": "./dist/dispatchers/http/index.d.ts",
      "default": "./dist/dispatchers/http/index.js"
    }
  },
  "files": [
    "dist",
    "docs/concepts",
    "docs/consumers",
    "docs/dispatchers",
    "docs/migration",
    "docs/producers",
    "docs/sources",
    "docs/extending.md",
    "docs/reliability.md",
    "docs/security.md",
    "docs/troubleshooting.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "bun run build && tsc -p tsconfig.json && tsc -p tsconfig.types.json",
    "test": "bun test src tests/unit tests/contract tests/docs",
    "test:integration": "bun test tests/integration",
    "test:orderable-integration": "scripts/test-orderable-integration.sh",
    "test:consumer-smoke": "bun run build && scripts/consumer-smoke.sh",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "lint": "biome lint .",
    "knip": "knip",
    "verify:package": "publint --strict && attw --pack . --profile esm-only",
    "check": "bun run format && bun run lint && bun run typecheck && bun run knip && bun run check:boundaries && bun run test && bun run verify:package",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:version-check": "bun run changeset:version && bun run check",
    "check:boundaries": "depcruise --config dependency-cruiser.config.mjs --output-type err-long src"
  },
  "peerDependencies": {
    "next": ">=16.4.5 <17",
    "payload": ">=3.94.1 <4"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "payload": {
      "optional": true
    }
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "standardwebhooks": "^1.3.0",
    "valibot": "^1.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.8",
    "@changesets/cli": "3.0.3",
    "@payloadcms/db-sqlite": "3.94.1",
    "@swc/core": "1.16.22",
    "@types/bun": "1.4.5",
    "dependency-cruiser": "18.9.0",
    "knip": "6.48.0",
    "next": "16.4.6",
    "npm": "12.2.3",
    "payload": "3.94.1",
    "publint": "0.3.25",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
